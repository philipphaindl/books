#import "../lib.typ": *

= Spickzettel

Diese Übersicht ist zum Nachschlagen gedacht, etwa kurz vor einer Vorlesung oder einem Coaching-Termin. Jede Zeile verdichtet ein Pattern auf das Problem, die Lösung und den Preis, den man dafür zahlt. Die Nummern entsprechen der Zählung bei @lakshmanan_ml_design_patterns_2020 und den Kapiteln dieses Handbuchs. Wer ein Pattern nur anhand einer Zeile erklären will, sollte vorher das zugehörige Kapitel lesen: Die Kürze hier geht auf Kosten der Mechanik.

#let gruppe(titel, kapitel) = table.cell(colspan: 5, fill: blau-hell, inset: (x: 0.7em, y: 0.4em))[
  #text(weight: "bold", fill: blau)[#titel] #h(0.5em) #text(fill: grau, size: 8pt)[#kapitel]
]

// Jede Zelle ist unteilbar, damit eine Zeile nie über einen Seitenumbruch läuft.
#let zeile(nr, name, problem, loesung, tradeoff) = (
  block(breakable: false, text(fill: blau, weight: "bold")[#nr]),
  block(breakable: false, text(weight: "bold")[#name]),
  block(breakable: false, problem),
  block(breakable: false, loesung),
  block(breakable: false, tradeoff),
)

#set text(size: 8.4pt)
#set par(leading: 0.55em, spacing: 0.6em)

#table(
  columns: (0.8cm, 2.75cm, 1fr, 1fr, 1fr),
  inset: (x: 0.45em, y: 0.4em),
  align: top + left,
  stroke: (x, y) => (y: if y == 0 { 0.8pt } else { 0.3pt + luma(205) }, x: none),
  table.header([*Nr.*], [*Pattern*], [*Problem*], [*Lösung*], [*Typischer Trade-off*]),

  gruppe([Data Representation], [Kapitel 5]),
  ..zeile(1, [Hashed Feature],
    [Kategorisches Feature mit sehr vielen oder unbekannten Werten; One-Hot wird riesig, neue Werte brechen das Vokabular.],
    [Wert mit einer deterministischen Hash-Funktion auf eine feste Zahl von Buckets abbilden.],
    [Kollisionen verschiedener Werte; keine Rückübersetzung; Bucket-Zahl ist eine Wahl.]),
  ..zeile(2, [Embeddings],
    [Kategorien oder Wörter als One-Hot sind riesig, dünn besetzt und kennen keine Ähnlichkeit.],
    [Werte auf dichte, niedrigdimensionale Vektoren abbilden, die so gelernt werden, dass Ähnliches nah beieinander liegt.],
    [Braucht Daten und Training; Dimension ist eine Wahl; Vektoren sind schwer zu deuten.]),
  ..zeile(3, [Feature Cross],
    [Die Wirkung hängt von der Kombination zweier Features; ein Modell, das Features nur einzeln gewichtet, sieht sie nicht.],
    [Ein zusätzliches Feature aus der Kombination bilden (Kreuzprodukt der Kategorien, ggf. gebündelt).],
    [Dimension wächst multiplikativ; viele leere Zellen; bei Bäumen und Netzen oft unnötig.]),
  ..zeile(4, [Multimodal Input],
    [Die Eingabe besteht aus verschiedenen Datenarten (Text, Bild, Tabelle), das Modell erwartet einen Vektor.],
    [Jede Modalität in eine numerische Darstellung überführen und zu einer gemeinsamen Eingabe zusammenfügen.],
    [Mehrere Vorverarbeitungspfade; unterschiedliche Skalen; was tun, wenn eine Modalität fehlt?]),

  gruppe([Problem Representation], [Kapitel 6]),
  ..zeile(5, [Reframing],
    [Eine Regression ist schlecht gestellt, etwa bei mehrgipfeliger Verteilung oder wenn Unsicherheit zählt.],
    [Die Aufgabe umformulieren, typischerweise Regression als Klassifikation über Wertebereiche (Bins).],
    [Auflösung geht durch die Bin-Grenzen verloren; die Ordnung der Klassen muss man sich eigens merken.]),
  ..zeile(6, [Multilabel],
    [Ein Beispiel gehört zu mehreren Klassen zugleich; Softmax erzwingt genau eine.],
    [Pro Label ein eigener Sigmoid-Ausgang, damit jede Wahrscheinlichkeit unabhängig ist.],
    [Schwellwert pro Label nötig; Abhängigkeiten zwischen Labels bleiben unberücksichtigt.]),
  ..zeile(7, [Ensembles],
    [Ein einzelnes Modell hat zu hohe Varianz oder zu hohen Bias.],
    [Mehrere Modelle kombinieren: Bagging gegen Varianz, Boosting gegen Bias, Stacking über ein Meta-Modell.],
    [Mehr Rechen- und Wartungsaufwand; schwerer erklärbar; ohne Verschiedenheit der Modelle kein Gewinn.]),
  ..zeile(8, [Cascade],
    [Die Vorhersage hängt von einer vorgelagerten Fallunterscheidung; ein Modell vermischt gegensätzliche Muster.],
    [Das Problem in eine Folge von Modellen zerlegen, deren Ausgabe das nächste Modell speist oder auswählt.],
    [Fehler pflanzen sich fort; alle Stufen müssen gemeinsam trainiert und versioniert werden.]),
  ..zeile(9, [Neutral Class],
    [Menschliche Labels sind bei manchen Fällen uneins; ein binäres Modell lernt Scheinunterschiede.],
    [Eine dritte, neutrale Klasse für wirklich uneindeutige Fälle einführen.],
    [Die Klasse muss definiert und gelabelt werden; mehr Klassen brauchen mehr Daten.]),
  ..zeile(10, [Rebalancing],
    [Seltene Klasse (z. B. 1 % Betrug): Das Modell sagt immer „normal“, die Accuracy ist hoch und wertlos.],
    [Passende Metrik (Precision, Recall, PR-AUC), Klassengewichte oder Resampling, nur auf den Trainingsdaten.],
    [Wahrscheinlichkeiten verschieben sich; Overfitting auf duplizierte Fälle; Schwellwert ist eine Fachentscheidung.]),

  gruppe([Model Training], [Kapitel 7]),
  ..zeile(11, [Useful Overfitting],
    [Manchmal braucht man keine Generalisierung: Der Eingaberaum ist bekannt, die Zielfunktion deterministisch.],
    [Bewusst auf die Trainingsdaten überanpassen, ohne Regularisierung und Early Stopping.],
    [Nur sicher, wenn der Eingaberaum wirklich abgedeckt bleibt; außerhalb unzuverlässig.]),
  ..zeile(12, [Checkpoints],
    [Langes Training bricht ab, oder man möchte auf einen früheren Zustand zurück.],
    [Zwischenstände (Gewichte, Optimizer-Zustand, Epoche) regelmäßig sichern und von dort fortsetzen.],
    [Speicher und I/O; ein Checkpoint ist keine vollständige Modellversion (siehe Pattern 27).]),
  ..zeile(13, [Transfer Learning],
    [Zu wenig Daten, um ein Modell von Grund auf zu trainieren.],
    [Ein vortrainiertes Modell einer verwandten Aufgabe nutzen: Features extrahieren oder letzte Schichten nachtrainieren.],
    [Domänenabstand; man erbt die Verzerrungen des Ausgangsmodells.]),
  ..zeile(14, [Distribution Strategy],
    [Das Training dauert zu lang, oder Modell und Daten passen nicht auf ein Gerät.],
    [Training auf mehrere Geräte verteilen, meist datenparallel mit synchronisierten Gradienten.],
    [Kommunikationsaufwand; effektive Batchgröße steigt, die Lernrate muss mit; mehr Betriebskomplexität.]),
  ..zeile(15, [Hyperparameter Tuning],
    [Hyperparameter (Lernrate, Baumtiefe …) werden nicht gelernt, falsche Werte kosten Qualität.],
    [Systematisch suchen (Grid, Random, Bayes’sch) und auf Validierungsdaten bewerten, automatisiert.],
    [Viele Trainingsläufe kosten Rechenzeit; Gefahr der Überanpassung an die Validierungsdaten.]),

  gruppe([Resilient Serving], [Kapitel 8]),
  ..zeile(16, [Stateless Serving Function],
    [Das Modell hängt am Trainingscode oder Notebook und lässt sich nicht skalieren.],
    [Modell samt Vorverarbeitung als zustandslose Funktion exportieren und hinter einem Endpunkt betreiben.],
    [Zustand und Historie müssen außerhalb liegen; Vorverarbeitung muss mit exportiert werden.]),
  ..zeile(17, [Batch Serving],
    [Sehr viele Vorhersagen, keine Echtzeit nötig; ein Online-Endpunkt wäre überlastet oder zu teuer.],
    [Vorhersagen als Batch-Job parallel über viele Instanzen berechnen und die Ergebnisse speichern.],
    [Ergebnisse sind bis zum nächsten Lauf veraltet; Zuordnung zur Eingabe braucht einen Schlüssel.]),
  ..zeile(18, [Continued Model Evaluation],
    [Das Modell altert, weil sich Daten und Zusammenhänge ändern (Drift), und niemand merkt es.],
    [Laufend Vorhersagen mit später eintreffenden Labels vergleichen und Schwellwerte für ein Neutraining festlegen.],
    [Labels kommen verspätet oder nie; Monitoring ist Betriebsaufwand.]),
  ..zeile(19, [Two-Phase Predictions],
    [Ein großes Modell ist für das Gerät zu teuer, zu langsam oder offline nicht verfügbar.],
    [Ein kleines Modell übernimmt lokal eine einfachere Teilaufgabe; das große Modell in der Cloud läuft nur, wenn es nötig ist.],
    [Zwei Modelle pflegen; das kleine ist ungenauer; der Anteil der Cloud-Aufrufe bestimmt die Kosten.]),
  ..zeile(20, [Keyed Predictions],
    [Bei Batch- und paralleler Verarbeitung kommen Ergebnisse nicht in Eingabereihenfolge zurück.],
    [Jede Instanz trägt einen Schlüssel, der unverändert durch das Modell in die Ausgabe gereicht wird.],
    [Schlüssel muss eindeutig sein und darf nicht als Feature ins Modell geraten.]),

  gruppe([Reproducibility], [Kapitel 9]),
  ..zeile(21, [Transform],
    [Vorverarbeitung ist im Training und im Serving getrennt implementiert und läuft auseinander (Training-Serving Skew).],
    [Die Transformation als Teil des Modells festhalten, inklusive der im Training gelernten Parameter.],
    [Modell und Transformation sind enger gekoppelt; Änderungen erfordern Neutraining.]),
  ..zeile(22, [Repeatable Splitting],
    [Zufällige Splits ändern sich mit jeder Datenänderung; verwandte Zeilen landen auf beiden Seiten (Leckage).],
    [Die Zuordnung aus dem Hash einer stabilen Spalte (Gruppe, Zeitpunkt) ableiten.],
    [Spalte sorgfältig wählen; das Verhältnis stimmt nur näherungsweise.]),
  ..zeile(23, [Bridged Schema],
    [Eine Datenquelle ändert ihr Schema; vom neuen Feature gibt es noch zu wenige Daten.],
    [Alte Daten auf das neue Schema überbrücken (Imputation, Zuordnung) und gemeinsam trainieren.],
    [Überbrückte Werte sind Näherungen; die Brücke muss dokumentiert und später entfernt werden.]),
  ..zeile(24, [Windowed Inference],
    [Die Vorhersage braucht aggregierte Historie (z. B. Mittel der letzten Stunden) aus einem Datenstrom.],
    [Den Zustand außerhalb des Modells in Zeitfenstern aggregieren und exakt wie im Training berechnen.],
    [Streaming-Infrastruktur; Fensterdefinition muss identisch sein; Wartezeit, bis das Fenster gefüllt ist.]),
  ..zeile(25, [Workflow Pipeline],
    [Der Ablauf ist ein Skript-Monolith; Schritte lassen sich weder einzeln wiederholen noch nachvollziehen.],
    [Schritte als eigenständige, containerisierte Stufen mit definierten Artefakten orchestrieren.],
    [Aufbau- und Betriebsaufwand; für Einmal-Experimente überdimensioniert.]),
  ..zeile(26, [Feature Store],
    [Features werden pro Team neu berechnet, im Training anders als im Serving.],
    [Zentraler Speicher mit versionierten Feature-Definitionen und konsistentem Zugriff offline und online.],
    [Zusätzliche Infrastruktur und Governance; lohnt erst bei mehreren Modellen oder Teams.]),
  ..zeile(27, [Model Versioning],
    [Modelländerungen müssen vergleichbar, rückholbar und für Clients abwärtskompatibel ausgerollt werden.],
    [Jede Modellversion mit Daten, Code und Hyperparametern festhalten und als eigene Version bereitstellen.],
    [Mehrere Versionen parallel zu betreiben kostet; Metadaten wollen gepflegt werden.]),

  gruppe([Responsible AI], [Kapitel 10]),
  ..zeile(28, [Heuristic Benchmark],
    [Eine Kennzahl wie „Fehler 4,2“ sagt allein nichts; Beteiligte können sie nicht einordnen.],
    [Mit einer einfachen Heuristik (Mittelwert, Regel) vergleichen; das Modell muss sie klar schlagen.],
    [Eine gute Heuristik kostet Arbeit; ein zu schwacher Benchmark täuscht Fortschritt vor.]),
  ..zeile(29, [Explainable Predictions],
    [Nutzer, Prüfer und Entwickler müssen verstehen, warum das Modell so entschieden hat.],
    [Je Vorhersage Feature-Beiträge berechnen (SHAP, LIME, Integrated Gradients) oder interpretierbare Modelle wählen.],
    [Erklärungen beschreiben das Modell, nicht die Wirklichkeit; Rechenkosten; trügerische Sicherheit.]),
  ..zeile(30, [Fairness Lens],
    [Das Modell behandelt Untergruppen systematisch schlechter, auch ohne das sensible Merkmal (Proxies).],
    [Daten und Metriken je Untergruppe prüfen, ein Fairness-Kriterium wählen, Gegenmaßnahmen planen.],
    [Kriterien widersprechen einander; es gibt kein allgemein gültiges „fair“; Gruppen-Features werden zur Prüfung gebraucht.]),
)
