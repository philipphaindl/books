#import "../lib.typ": *

= Glossar <anh-glossar>

Das Glossar erklärt die wichtigsten Fachbegriffe in ein bis drei Sätzen. Nach dem deutschen Begriff steht in Klammern der englische Fachbegriff, wie er in den Foliensätzen und in der Literatur verwendet wird; fehlt die Klammer, ist der englische Begriff auch im Deutschen üblich. Die Kapitelangabe verweist auf die ausführliche Behandlung, die Formeln stehen in Anhang A.

#let begriffe = (
  ([Action Design Research (ADR)], none, "2", [Variante der Design Science Research, die Bauen, organisationale Intervention und Evaluation nicht nacheinander, sondern gleichzeitig durchführt; vier Phasen und sieben Prinzipien @sein2011action.]),
  ([Adjusted Rand Index (ARI)], none, "5", [Zufallskorrigiertes Maß für die Ähnlichkeit zweier Partitionen derselben Einheiten, etwa menschlicher und vom LLM gebildeter Themen; unabhängig von den Themennamen. 1 bedeutet identische Gruppierung, Werte um 0 Zufallsniveau.]),
  ([Aktive statistische Inferenz], "active statistical inference", "6", [Verfahren, das menschliche Labels bevorzugt dort einholt, wo das Modell unsicher ist, und die Auswahl über inverse Wahrscheinlichkeitsgewichtung korrigiert @zrnic2024active.]),
  ([Algorithmische Treue], "algorithmic fidelity", "4", [Grad, in dem ein Sprachmodell die Einstellungs- und Zusammenhangsmuster einer menschlichen Subpopulation reproduziert, wenn es auf deren Merkmale konditioniert wird @argyle2023out.]),
  ([Alternative Annotator Test (Alt-Test)], "alternative annotator test", "5, 7", [Statistischer Test, ob ein LLM menschliche Annotatoren ersetzen kann: Das LLM wird im Leave-one-out-Design gegen jeden einzelnen Annotator relativ zu den übrigen verglichen, mit einem vorab festgelegten Spielraum $epsilon$ @calderon2025alternative.]),
  ([Annotation], "annotation, coding, labeling", "5", [Zuordnung von Kategorien, Scores oder Freitext-Codes zu Einheiten wie Texten oder Bildern nach einem Codebuch; bei LLMs eine Messung mit Modell, Prompt und Parametern als Instrument.]),
  ([Answer Relevancy], none, "9", [RAG-Metrik, die misst, ob eine Antwort zur Frage passt. In RAGAS über die Kosinusähnlichkeit zwischen der Nutzerfrage und aus der Antwort zurückgenerierten Fragen, in DeepEval als Anteil relevanter Aussagen; gleicher Name, verschiedene Operationalisierung.]),
  ([Arena-Hard], none, "7", [Automatischer Benchmark mit LLM-Richter, der auf hohe Trennschärfe und Übereinstimmung mit Chatbot-Arena-Rankings ausgelegt ist @li2025crowdsourced.]),
  ([Artefakt], "artifact", "2", [Vom Menschen geschaffenes Objekt, das ein Problem lösen soll: Konstrukt, Modell, Methode oder Instanziierung @hevner2004design. Zentraler Forschungsgegenstand der Design Science Research.]),
  ([Assertion], none, "7", [Prüfbare Einzelbedingung an eine LLM-Ausgabe, als Code oder LLM-Kriterium formuliert. EvalGen bewertet Assertion-Sets über Coverage und False Failure Rate @shankar2024validates.]),
  ([Atomarer Claim], "atomic claim", "9", [Kleinste überprüfbare Aussage, in die ein LLM eine Antwort oder Referenz zerlegt. Grundlage claim-basierter Metriken wie Faithfulness, Context Recall und FActScore.]),
  ([Automatische Promptoptimierung], "automatic prompt optimization", "3", [Verfahren, bei denen ein LLM Prompts selbst vorschlägt und anhand einer Metrik verbessert @zhou2023large @yang2024large.]),
  ([Average Precision (AP)], none, "9", [Mittel der Precision an den Rängen relevanter Dokumente, geteilt durch die Zahl aller relevanten Dokumente; ihr Mittel über Anfragen ist die Mean Average Precision (MAP) @manning2008introduction.]),
  ([Batch-Invarianz], "batch invariance", "10", [Eigenschaft einer Inferenzimplementierung, dass das Ergebnis einer Anfrage nicht von der Größe und Zusammensetzung des Rechenbatches abhängt; Voraussetzung für bitgenau reproduzierbare Ausgaben selbst gehosteter Modelle @he2025defeating.]),
  ([Batch-Verarbeitung], "batch processing", "3, 10", [Asynchrone Abarbeitung vieler Anfragen zu einem reduzierten Preis, bei den großen Anbietern zum halben synchronen Preis (Stand: 11. November 2026) @anthropic2026batch. Cache-Treffer sind in Batches nur bestmöglich garantiert.]),
  ([BBQ], "Bias Benchmark for QA", "8", [Frage-Antwort-Benchmark mit ambigen Kontexten (richtige Antwort: unbekannt) und eindeutigen Kontexten; misst, ob ein Modell bei fehlender Information auf soziale Stereotype zurückgreift @parrish2022bbq.]),
  ([Benjamini-Yekutieli-Korrektur], "Benjamini-Yekutieli procedure", "5", [Verfahren zur Kontrolle der False Discovery Rate, das auch bei abhängigen Tests gilt; im Alt-Test für die Tests gegen die einzelnen Annotatoren verwendet @calderon2025alternative.]),
  ([Bewertungsformat (punktweise)], "pointwise evaluation", "7", [Ein Richter bewertet eine einzelne Antwort absolut, meist mit Rubrik und Scoreskala; geeignet für absolute Qualitätsaussagen, anfällig für Skalendrift.]),
  ([Bias (sozialer)], "social bias", "8", [Systematische Ungleichbehandlung oder stereotype Darstellung sozialer Gruppen durch ein Modell. Blodgett et al. fordern, Bias-Messungen an konkreten Schäden und ihrer normativen Begründung festzumachen @blodgett2020language.]),
  ([Bootstrap], none, "5, 6, 7", [Resamplingverfahren für Standardfehler und Konfidenzintervalle. Ob über Einheiten oder über Urteilspaare resampelt wird, ändert das Intervall und muss berichtet werden; PPBoot überträgt die Idee auf Prediction-Powered Inference @zrnic2024note.]),
  ([Bradley-Terry-Modell], "Bradley-Terry model", "7", [Logistisches Modell für Paarvergleiche, das jedem Modell eine latente Stärke zuordnet; Grundlage der Rankings von Chatbot Arena, das von Online-Elo auf Bradley-Terry-Koeffizienten umgestellt hat @chiang2024chatbot.]),
  ([Brennan-Prediger-Koeffizient], "Brennan-Prediger coefficient, PABAK", "5", [Zufallskorrigierte Übereinstimmung mit Gleichverteilung als Zufallsmodell; für zwei Kategorien identisch mit PABAK @byrt1993bias.]),
  ([Chain-of-Thought], "chain-of-thought prompting", "3", [Prompttechnik, bei der das Modell Zwischenschritte ausformuliert, bevor es antwortet @wei2022chain; in der Zero-Shot-Variante genügt eine Aufforderung zum schrittweisen Denken @kojima2022large.]),
  ([Chatbot Arena], none, "7", [Offene Plattform, auf der Nutzende zwei anonyme Modellantworten vergleichen; die Paarvergleiche werden mit dem Bradley-Terry-Modell zu einem Ranking mit Konfidenzintervallen verdichtet @chiang2024chatbot.]),
  ([Citation Precision und Recall], "citation precision, citation recall", "9", [Zitationsmetriken aus ALCE: Recall prüft per NLI-Modell, ob die zitierten Passagen eine Aussage stützen; Precision, ob jedes einzelne Zitat dazu beiträgt @gao2023enabling.]),
  ([Codebuch], "codebook", "5", [Verbindliche Beschreibung der Kategorien einer Annotation mit Definitionen, Abgrenzungen und Beispielen. Für LLMs muss es oft umstrukturiert werden; Halterman und Keith machen das zu einem eigenen, menschlich gesteuerten Schritt @halterman2026codebook.]),
  ([Codebuch-Einfrieren], "codebook freezing", "5", [Festschreiben des Codebuchs vor der deduktiven Anwendung und Validierung; Ableitung und Validierung auf denselben Daten überschätzen die Güte @deregnaucourt2026large.]),
  ([Cohens d], "Cohen's d", "1", [Standardisierte Mittelwertdifferenz zweier Gruppen, geteilt durch die gepoolte Standardabweichung; Konventionen klein 0.2, mittel 0.5, groß 0.8 @cohen1992power.]),
  ([Cohens Kappa], "Cohen's kappa", "5, 7", [Zufallskorrigierte Übereinstimmung zweier Codierender, bei der die Zufallsübereinstimmung aus den eigenen Randverteilungen beider berechnet wird @cohen1960coefficient. Anfällig für Prävalenz- und Bias-Paradoxien.]),
  ([Constrained Decoding], "constrained decoding, structured outputs", "3", [Einschränkung der Tokenauswahl während der Generierung, sodass die Ausgabe einem Schema wie JSON entspricht; erleichtert das Parsen von Labels, verändert aber die Antwortverteilung.]),
  ([Context Engineering], none, "3", [Gestaltung des gesamten Modellkontexts über den Prompt hinaus: Auswahl, Reihenfolge, Kompression und Aktualisierung von Instruktionen, Beispielen, Dokumenten, Werkzeugausgaben und Gedächtnis.]),
  ([Context Precision], none, "9", [Rangsensitives Maß dafür, ob relevante Chunks oben in der abgerufenen Liste stehen; in RAGAS eine AP-Variante, deren Nenner nur gefundene relevante Chunks zählt @ragas2026contextprecision.]),
  ([Context Recall], none, "9", [Anteil der Claims einer Referenzantwort, die durch den abgerufenen Kontext gestützt werden @ragas2026contextrecall; misst, ob das Retrieval alles Nötige liefert.]),
  ([Cross-PPI], "cross-prediction-powered inference", "6", [Prediction-Powered Inference für den Fall, dass das Vorhersagemodell erst auf den gelabelten Daten trainiert werden muss; nutzt Cross-Fitting über Folds @zrnic2024cross.]),
  ([CrowS-Pairs], none, "8", [Datensatz minimaler Satzpaare, die sich nur in der Gruppenzugehörigkeit unterscheiden; gemessen wird, wie oft ein maskiertes Sprachmodell den stärker stereotypen Satz bevorzugt (ideal 50 Prozent) @nangia2020crows.]),
  ([Datenkontamination], "data contamination", "4, 5", [Überlappung von Evaluations- oder Validierungsdaten mit den Trainingsdaten eines Modells; öffentlich gelabelte Benchmarks sind deshalb als Validierungsmenge ungeeignet @tornberg2024best.]),
  ([Datenresidenz], "data residency", "10", [Verarbeitung von Anfragen in einer festgelegten Region. Bei manchen Anbietern mit Preisaufschlag verbunden (Stand: 11. November 2026) @anthropic2026pricing; relevant für Datenschutz und Kostenmodell.]),
  ([Demographic Parity], "demographic parity, independence", "8", [Fairnesskriterium, nach dem die Selektionsrate einer Entscheidung in allen Gruppen gleich sein soll; gemessen als Differenz zwischen größter und kleinster Gruppenrate @barocas2023fairness.]),
  ([Designprinzip], "design principle", "2", [Präskriptive Aussage, die festhält, was ein Artefakt leisten soll und wie, für wen und warum; Gregor et al. geben dafür eine Anatomie mit Ziel, Akteuren, Kontext, Mechanismus und Begründung an @gregor2020research.]),
  ([Design Science Research (DSR)], none, "2", [Forschungsparadigma, das Wissen durch Entwurf und Evaluation innovativer Artefakte gewinnt, im Unterschied zur verhaltenswissenschaftlichen Forschung, die bestehende Phänomene erklärt @hevner2004design @haindl2027research.]),
  ([Designtheorie], "design theory", "2", [Theorie darüber, wie etwas gestaltet werden soll; Gregor und Jones beschreiben ihre Bestandteile von Zweck und Geltungsbereich bis zu prüfbaren Aussagen @gregor2007anatomy.]),
  ([Differenzieller Messfehler], "differential measurement error", "6", [Messfehler, dessen Größe von einer Analysevariable abhängt, etwa ein LLM, das in einer Gruppe häufiger falsch labelt. Er verzerrt Gruppenvergleiche und Regressionskoeffizienten in beliebige Richtung.]),
  ([Disparate-Impact-Verhältnis], "disparate impact ratio", "8", [Quotient aus kleinster und größter Selektionsrate; die Vier-Fünftel-Regel verlangt mindestens 0.8 @barocas2023fairness.]),
  ([Dorner-Schranke], "factor-two bound", "7", [Ergebnis von Dorner et al.: Ein binärer LLM-Richter, der nicht besser urteilt, als das bewertete Modell seine Aufgabe löst, kann die nötige Zahl an Referenzlabels höchstens halbieren @dorner2025limits.]),
  ([Drei-Zyklen-Modell], "three cycle view", "2", [Sicht auf DSR als Relevanz-, Rigor- und Designzyklus: Anforderungen aus der Umgebung, Fundierung in der Wissensbasis und iteratives Bauen und Evaluieren @hevner2007three.]),
  ([DSL], "design-based supervised learning", "6", [Schätzverfahren, das LLM-Labels mit einer Zufallsstichprobe menschlicher Labels über Pseudo-Outcomes kombiniert; valide auch bei beliebig verzerrten Surrogaten, solange die Ziehungswahrscheinlichkeiten bekannt sind @egami2023using.]),
  ([DSRM-Prozessmodell], "design science research methodology", "2", [Sechsstufiges Vorgehensmodell: Problemidentifikation, Lösungsziele, Entwurf und Entwicklung, Demonstration, Evaluation, Kommunikation, mit vier möglichen Einstiegspunkten @peffers2007design.]),
  ([Effektive Stichprobengröße], "effective sample size", "6", [Zahl menschlicher Labels, die eine klassische Schätzung für dieselbe Präzision bräuchte wie ein PPI-Schätzer; sie wächst höchstens auf das $1 \/ (1 - rho^2)$-Fache @angelopoulos2024ppipy.]),
  ([Effektstärke], "effect size", "1", [Maß für die Größe eines Effekts unabhängig von der Stichprobengröße, etwa $d$, $r$ oder $eta^2$; Grundlage jeder Poweranalyse @lakens2013calculating.]),
  ([Effektvalidität], "effect validity", "4", [Übereinstimmung simulierter mit tatsächlichen Treatment-Effekten. Realistische Einzelantworten garantieren sie nicht @li2026statistical.]),
  ([Elo-Rating], "Elo rating", "7", [Online aktualisiertes Stärkemaß aus Paarvergleichen; für statistische Schätzung mit Konfidenzintervallen ist das Bradley-Terry-Modell besser geeignet @chiang2024chatbot.]),
  ([Equalized Odds], "equalized odds, separation", "8", [Fairnesskriterium, nach dem True-Positive- und False-Positive-Rate in allen Gruppen gleich sind @hardt2016equality.]),
  ([Equal Opportunity], "equal opportunity", "8", [Abschwächung von Equalized Odds, die nur gleiche True-Positive-Raten über Gruppen verlangt @hardt2016equality.]),
  ([Evaluationsstrategie (FEDS)], "Framework for Evaluation in Design Science", "2", [Rahmen zur Wahl einer DSR-Evaluationsstrategie entlang der Achsen formativ/summativ und künstlich/naturalistisch @venable2016feds.]),
  ([Externe Validität], "external validity", "1", [Frage, ob ein kausaler Zusammenhang über Personen, Settings, Treatments und Outcomes hinweg gilt @shadish2002experimental.]),
  ([Faithfulness], none, "9", [Anteil der Claims einer Antwort, die durch den abgerufenen Kontext gestützt werden @ragas2026faithfulness. DeepEval verwendet das schwächere Kriterium, dass ein Claim dem Kontext nicht widerspricht.]),
  ([Familienweise Fehlerrate], "familywise error rate", "1", [Wahrscheinlichkeit, unter der Nullhypothese in einer Familie von Tests mindestens ein falsch-positives Ergebnis zu erhalten; wächst schnell mit der Zahl verfügbarer Analysevarianten @gelman2013garden.]),
  ([Few-Shot-Prompting], "few-shot prompting", "3", [Prompting mit einigen Beispielen der Aufgabe im Kontext. Auswahl, Anzahl, Labels und Reihenfolge der Beispiele beeinflussen das Ergebnis @lu2022fantastically.]),
  ([Flattening], "flattening", "4", [Verzerrung synthetischer Stichproben, bei der Antwortverteilungen innerhalb einer Gruppe zu wenig streuen und Gruppen homogener erscheinen als in Wirklichkeit.]),
  ([Fleiss' Kappa], "Fleiss' kappa", "5", [Verallgemeinerung von Scotts Pi auf mehr als zwei Ratende pro Einheit, auf Basis des Anteils übereinstimmender Ratendenpaare @fleiss1971measuring.]),
  ([FormatSpread], none, "3", [Verfahren zur Schätzung der Leistungsspanne eines Modells über semantisch äquivalente Promptformate unter begrenztem Budget @sclar2024quantifying.]),
  ([Garten der Gabelungen], "garden of forking paths", "1", [Problem, dass datenabhängige Analyseentscheidungen implizit viele Tests erzeugen, auch wenn nur einer gerechnet wird @gelman2013garden.]),
  ([Generative Agenten], "generative agents", "4", [LLM-gesteuerte Simulationsfiguren mit Gedächtnis, Reflexion und Planung; Erinnerungen werden nach Aktualität, Wichtigkeit und Relevanz abgerufen @park2023generative.]),
  ([G-Eval], none, "7", [LLM-Richter mit Kriteriumsprompt, automatisch erzeugten Bewertungsschritten und einem mit Tokenwahrscheinlichkeiten gewichteten Score @liu2023geval.]),
  ([Groundedness], none, "9", [Maß dafür, wie weit die Aussagen einer Antwort im Kontext belegt sind; in TruLens per LLM-Rating pro Aussage, wobei Enthaltungen als belegt zählen @trulens2026providers.]),
  ([Gruppenfairness], "group fairness", "8", [Familie von Kriterien, die Entscheidungsraten oder Fehlerraten zwischen Gruppen vergleichen, etwa Demographic Parity, Equalized Odds und Equal Opportunity @barocas2023fairness.]),
  ([Gwets AC1], "Gwet's AC1", "5", [Übereinstimmungskoeffizient, dessen Zufallsübereinstimmung bei dominierender Kategorie klein wird; robust gegen das Prävalenzparadox, verdeckt aber fehlende Übereinstimmung auf seltenen Klassen @gwet2008computing.]),
  ([Halluzination], "hallucination", "9", [Aussage eines Modells, die weder durch Referenz noch durch Kontext gestützt ist; RAGChecker misst ihren Anteil an allen Claims der Antwort @ru2024ragchecker.]),
  ([HARKing], "hypothesizing after the results are known", "1", [Darstellung nachträglich gebildeter Hypothesen, als wären sie vorab formuliert worden; eine Ursache der Replikationskrise @haindl2027research.]),
  ([Hintergrundtemperatur], "background temperature", "10", [Effektive Temperatur, die die implementierungsbedingte Variabilität eines Modells bei nominaler Temperatur 0 beschreibt @messina2026introducing.]),
  ([Homo silicus], none, "4", [Verwendung von LLMs als simulierte ökonomische Akteure, um Verhaltensexperimente vorab durchzuspielen @horton2023large.]),
  ([Induktives Codieren], "inductive coding", "5", [Bildung von Codes aus den Daten statt aus einem vorgegebenen Codebuch. Mit LLMs typischerweise als Wechsel aus Codegenerierung, Duplikatbereinigung und Aushandlung mit menschlichen Codierenden.]),
  ([Induktive thematische Sättigung (ITS)], "inductive thematic saturation", "5", [Verhältnis einzigartiger zu allen kumulierten Codes über eine Interviewfolge, vorgeschlagen als Validitätsindikator für LLM-Erstcodierung @depaoli2025reflections.]),
  ([Interne Validität], "internal validity", "1", [Frage, ob eine beobachtete Kovariation in einer Studie kausal ist @shadish2002experimental.]),
  ([Intraklassenkorrelation (ICC)], "intraclass correlation", "5", [Reliabilitätsmaß für metrische oder Likert-Ratings aus einer Varianzzerlegung; die Varianten für absolute Übereinstimmung und für Konsistenz unterscheiden sich in der Behandlung systematischer Verschiebungen @mcgraw1996forming.]),
  ([Intrinsische und extrinsische Bias-Metrik], "intrinsic and extrinsic bias metric", "8", [Intrinsische Metriken messen Bias in Einbettungen oder Tokenwahrscheinlichkeiten, extrinsische in Ausgaben oder Entscheidungen einer Anwendung; beide korrelieren oft nur schwach @gallegos2024bias.]),
  ([Jensen-Shannon-Divergenz], "Jensen-Shannon divergence", "4", [Symmetrisierte, beschränkte Variante der Kullback-Leibler-Divergenz gegenüber der Mischverteilung @lin1991divergence.]),
  ([Kappa-Paradoxa], "kappa paradoxes", "5", [Hohe prozentuale Übereinstimmung bei niedrigem Kappa durch schiefe Prävalenz (Prävalenzparadoxon) und steigendes Kappa bei auseinanderlaufenden Randverteilungen (Bias-Paradoxon) @feinstein1990high.]),
  ([Kendalls Tau], "Kendall's tau", "3, 7, 9", [Rangkorrelation auf Basis konkordanter und diskordanter Paare; Standardmaß für die Übereinstimmung von System-Rankings in der Metaevaluation.]),
  ([Kolmogorov-Smirnov-Distanz], "Kolmogorov-Smirnov distance", "10", [Größter Abstand zweier Verteilungsfunktionen; bei der Schätzung der Hintergrundtemperatur als Divergenz verwendet @messina2026introducing.]),
  ([Kompressionsrate], "compression rate", "3", [Verhältnis der Tokenzahl eines komprimierten zum ursprünglichen Prompt, etwa bei LLMLingua @pan2024llmlingua2.]),
  ([Konfiguration], "configuration", "5, 10", [Gesamtheit der Entscheidungen, die ein LLM-Label bestimmen: Modell und Version, Prompt, Beispiele, Decodierparameter und Ausgabeparsing. Verschiedene Konfigurationen können zu verschiedenen Schlüssen führen @baumann2025large.]),
  ([Konfliktrate], "conflict rate", "7", [Anteil der Paarvergleiche, deren Urteil sich beim Vertauschen der Reihenfolge ändert; Maß für Positionsverzerrung @wang2024large.]),
  ([Konsistenzrate], "consistency rate", "7, 8", [Anteil gleicher Urteile zweier ungestörter Läufe; Rauschuntergrenze für die Interpretation der Robustheitsrate @ye2025justice.]),
  ([Konstruktvalidität], "construct validity", "1", [Frage, ob die Operationalisierungen einer Studie die gemeinten Konstrukte abbilden @shadish2002experimental.]),
  ([Kontextfenster], "context window", "3", [Maximale Tokenzahl, die ein Modell gleichzeitig verarbeitet. Die effektiv nutzbare Länge ist oft deutlich kürzer @modarressi2025nolima.]),
  ([Kontrafaktisches Audit], "counterfactual audit", "8", [Bias-Test, der den Inhalt konstant hält und nur ein Gruppenmerkmal wie Name, Pronomen oder Dialekt variiert; sollte mit nicht demografischen Kontrollstörungen kombiniert werden @hofmann2024ai.]),
  ([Kontrollvariate], "control variate", "6", [Hilfsgröße mit bekanntem oder gut schätzbarem Mittel, die die Varianz eines Schätzers senkt; PPI++ für den Mittelwert hat genau diese Form @angelopoulos2023ppi.]),
  ([Kreuzanpassung], "cross-fitting", "6", [Aufteilung der Daten in Folds, bei der ein Hilfsmodell jeweils auf den anderen Folds trainiert und auf dem eigenen angewandt wird; verhindert Überanpassung bei DSL und Cross-PPI @egami2023using.]),
  ([Krippendorffs Alpha], "Krippendorff's alpha", "5", [Übereinstimmungskoeffizient für beliebig viele Codierende, fehlende Werte und verschiedene Skalenniveaus, definiert über beobachtete und erwartete Nichtübereinstimmung @krippendorff2018content.]),
  ([Kullback-Leibler-Divergenz], "Kullback-Leibler divergence", "4", [Asymmetrisches Maß für die Abweichung einer Verteilung von einer anderen; unendlich, wenn die Vergleichsverteilung einer möglichen Kategorie Wahrscheinlichkeit null gibt @lin1991divergence.]),
  ([Längenkontrollierte Gewinnrate], "length-controlled win rate", "7", [Kontrafaktische Gewinnrate bei Längendifferenz null aus einem logistischen Modell, verwendet in AlpacaEval @dubois2024length.]),
  ([Längenverzerrung], "verbosity bias, length bias", "7", [Neigung von LLM-Richtern, längere Antworten zu bevorzugen; längenkontrollierte Gewinnraten korrigieren dafür @dubois2024length.]),
  ([Leakage (Datenleck)], "data leakage", "1", [Fehler in der Analysepipeline, bei dem Information aus Testdaten in Training oder Modellauswahl gelangt und die Leistung überschätzt wird; im Notebook 01 an reinem Rauschen demonstriert.]),
  ([LLM-as-a-Judge], none, "7", [Verwendung eines Sprachmodells zur Bewertung von Ausgaben, punktweise mit Rubrik oder paarweise; verlangt eine Validierung gegen menschliche Urteile @zheng2023judging.]),
  ([LLM Hacking], "LLM hacking", "5, 6", [Begriff von Baumann et al. für falsche wissenschaftliche Schlüsse, die durch die Wahl der LLM-Konfiguration entstehen, absichtlich oder unabsichtlich @baumann2025large.]),
  ([Lost in the Middle], none, "3", [Befund, dass Modelle Information in der Mitte langer Kontexte schlechter nutzen als am Anfang oder Ende @liu2024lost.]),
  ([Matched Guise Probing], none, "8", [Verfahren zur Messung verdeckter Vorurteile, bei dem dieselben Inhalte in zwei Varietäten präsentiert und die Wahrscheinlichkeiten von Eigenschaftswörtern verglichen werden @hofmann2024ai.]),
  ([Mean Reciprocal Rank (MRR)], none, "9", [Mittel des Kehrwerts des Rangs des ersten relevanten Treffers über alle Anfragen @craswell2016mean.]),
  ([Mehrprompt-Evaluation], "multi-prompt evaluation", "3", [Evaluation über viele Paraphrasen einer Instruktion mit Kennzahlen wie MaxP, AvgP und CPS statt mit einem einzelnen Prompt @mizrahi2024state.]),
  ([Mensch-Mensch-Übereinstimmung], "inter-annotator agreement", "5, 7", [Übereinstimmung menschlicher Codierender auf denselben Items; der sinnvollere Vergleichsmaßstab für ein LLM als eine feste Schwelle @tornberg2024best.]),
  ([Meta-Evaluation], "meta-evaluation", "7, 9", [Bewertung einer Bewertungsmethode, etwa eines LLM-Richters oder einer RAG-Metrik, gegen menschliche Urteile über Übereinstimmung, Korrelation oder Rangvergleich.]),
  ([Mixed Methods], none, "1", [Forschungsdesigns, die qualitative und quantitative Stränge verbinden, etwa konvergent, erklärend-sequenziell oder explorativ-sequenziell @creswell2025designing.]),
  ([Modell-Snapshot], "model snapshot", "10", [Fest datierte Modellversion eines Anbieters. Für Reproduzierbarkeit muss der genaue Snapshot berichtet werden, weil sich das Verhalten gleichnamiger Modelle über die Zeit ändern kann @chen2024chatgpts.]),
  ([Multiversumsanalyse], "multiverse analysis", "1", [Durchführung einer Analyse über alle vertretbaren Kombinationen von Analyseentscheidungen, um die Robustheit eines Befunds sichtbar zu machen @steegen2016increasing.]),
  ([Nachsichtigkeit], "leniency", "7", [Nachsichtigkeit eines Richters: die Wahrscheinlichkeit, bei einem Fehlurteil zugunsten der bewerteten Antwort zu entscheiden @thakur2025judging.]),
  ([nDCG], "normalized discounted cumulative gain", "9", [Rangmaß für abgestufte Relevanz, das Gewinne mit dem Logarithmus des Rangs abzinst und durch den Wert der idealen Ordnung teilt @jarvelin2002cumulated.]),
  ([Nichtdeterminismus], "nondeterminism", "10", [Unterschiedliche Ausgaben bei identischer Eingabe und Einstellung; tritt bei gehosteten Modellen auch bei Temperatur 0 auf @atil2025nondeterminism.]),
  ([Noise Sensitivity], none, "9", [Anteil falscher Claims in einer Antwort, die auf relevanten oder irrelevanten abgerufenen Kontext zurückgehen; kleiner ist besser @ragas2026noisesensitivity.]),
  ([Nugget-Evaluation], "nugget evaluation", "9", [Bewertung von RAG-Antworten danach, welche vorab bestimmten Informationseinheiten (Nuggets) sie enthalten; in TREC RAG mit vitalen und optionalen Nuggets @pradeep2025great.]),
  ([OpinionQA], none, "4", [Datensatz aus Meinungsumfragen zur Messung, wessen Meinungen ein Sprachmodell widerspiegelt; Repräsentativität über die Wasserstein-Distanz der Antwortverteilungen @santurkar2023whose.]),
  ([Paarweiser Vergleich], "pairwise comparison", "7", [Bewertungsformat, bei dem ein Richter zwischen zwei Antworten wählt; anfällig für Positionsbias und nur relativ interpretierbar.]),
  ([Panel von Richtern], "panel of LLM evaluators, jury", "7", [Kombination mehrerer Richtermodelle aus verschiedenen Familien mit Mehrheits- oder Mittelwertbildung @verga2024replacing.]),
  ([Paradigma], "research paradigm", "1", [Weltsicht einer Forschungsgemeinschaft mit Annahmen über Wirklichkeit, Erkenntnis und Methode, etwa postpositivistisch, konstruktivistisch oder pragmatisch @creswell2022research.]),
  ([Persona-Prompting], "persona prompting, sociodemographic prompting", "4, 8", [Konditionierung eines LLM auf ein Personenprofil. Es reproduziert gruppenspezifische menschliche Wahrnehmungen nicht zuverlässig @orlikowski2025beyond.]),
  ([p-Hacking], none, "1", [Ausnutzen analytischer Freiheitsgrade, bis ein Ergebnis signifikant wird @simmons2011false.]),
  ([Positionskonsistenz], "position consistency", "7", [Anteil der Paarvergleiche, deren Urteil das Vertauschen der Reihenfolge übersteht; Komplement der Konfliktrate @shi2025judging.]),
  ([Positionsverzerrung], "position bias", "7", [Bevorzugung einer Antwort wegen ihrer Position im Prompt; gemessen über Konfliktrate oder Positionskonsistenz bei vertauschter Reihenfolge @wang2024large.]),
  ([Positiver Vorhersagewert], "positive predictive value", "1", [Wahrscheinlichkeit, dass ein signifikanter Befund wahr ist; hängt von Prä-Studien-Odds, Power, Signifikanzniveau und Bias ab @ioannidis2005why.]),
  ([Power], "statistical power", "1", [Wahrscheinlichkeit, einen tatsächlich vorhandenen Effekt bestimmter Größe zu entdecken; Grundlage der Stichprobenplanung @cohen1992power.]),
  ([PPI], "prediction-powered inference", "6, 9", [Inferenzverfahren, das viele Modellvorhersagen mit wenigen Goldlabels kombiniert: Der mittlere Modellfehler auf der Goldstichprobe korrigiert die Schätzung auf allen Vorhersagen @angelopoulos2023prediction.]),
  ([PPI++], none, "6", [Erweiterung von PPI um einen Gewichtungsparameter $lambda$, der aus den Daten geschätzt wird; asymptotisch nie schlechter als klassische Inferenz @angelopoulos2023ppi.]),
  ([PPI-Korrelation], "PPI correlation", "6", [Korrelation zwischen Goldlabel und Modellvorhersage, die den möglichen Effizienzgewinn von PPI++ bestimmt @broska2025mixed.]),
  ([Präregistrierung], "preregistration", "1", [Öffentliche Festlegung von Hypothesen, Design und Analyseplan vor der Datenerhebung @nosek2018preregistration. Bei LLM-Studien gehören Modell, Prompt und Konfiguration dazu @baumann2025large.]),
  ([Prävalenzparadoxon], "prevalence paradox", "5", [Siehe Kappa-Paradoxa: Bei schiefer Kategorienverteilung fällt Kappa trotz hoher prozentualer Übereinstimmung stark ab @gwet2008computing.]),
  ([Prompt], none, "3", [Eingabe an ein generatives Modell; eine Promptvorlage enthält Platzhalter, eine Prompttechnik ist ein wiederverwendbares Muster zur Promptgestaltung @schulhoff2024prompt.]),
  ([Prompt-Caching], "prompt caching", "3, 10", [Wiederverwendung eines gemeinsamen Promptpräfixes über Anfragen hinweg zu einem reduzierten Lesepreis; Schreiben in den Cache kostet einen Aufschlag @anthropic2026prompt.]),
  ([Prompt Injection], none, "3", [Angriff, bei dem Text in Daten oder Dokumenten als Anweisung an das Modell wirkt; in Forschungspipelines zugleich ein Qualitäts- und ein Sicherheitsproblem.]),
  ([Promptsensitivität], "prompt sensitivity, brittleness", "3", [Abhängigkeit der Leistung von bedeutungsgleichen Änderungen an Formulierung oder Format eines Prompts @sclar2024quantifying.]),
  ([Prompt-Stabilität], "prompt stability", "5", [Übereinstimmung der Labels über Paraphrasen derselben Instruktion, etwa als Krippendorffs Alpha über Promptvarianten @barrie2024prompt.]),
  ([Qualitätsmodell], "quality model", "9", [Strukturierte Menge von Qualitätsmerkmalen eines Produkts, etwa nach ISO/IEC 25010 @isoiec2023systems; Kapitel 9 operationalisiert sie für RAG-Systeme mit Retrieval-, Generierungs- und Betriebsmetriken.]),
  ([RAG], "retrieval-augmented generation", "9", [Generierung, bei der ein Modell zu jeder Anfrage abgerufene Dokumente als Kontext erhält @lewis2020retrieval.]),
  ([RAGAS], none, "9", [Rahmenwerk und Bibliothek für referenzfreie RAG-Evaluation mit LLM-basierten Metriken; viele heutige Metriken der Bibliothek wurden im ursprünglichen Paper nicht validiert @es2024ragas.]),
  ([Reasoning-Modell], "reasoning model", "3", [Modell, das vor der Antwort intern Denkschritte erzeugt; diese Reasoning-Tokens werden als Ausgabetokens abgerechnet @anthropic2026steering.]),
  ([Recall\@k und Precision\@k], "recall at k, precision at k", "9", [Anteil der relevanten Dokumente, die unter den ersten $k$ Treffern sind, bzw. Anteil relevanter Dokumente unter den ersten $k$ Treffern @ragas2026contextrecall.]),
  ([Referenzstandard], "reference standard", "5", [Menschliche Labels, gegen die ein LLM validiert wird. Der Begriff ist ehrlicher als Ground Truth, weil auch menschliche Labels fehlerbehaftet sind.]),
  ([Reflexive thematische Analyse], "reflexive thematic analysis", "1", [Qualitatives Verfahren, bei dem Themen aktiv von Forschenden als Muster geteilter Bedeutung konstruiert werden; Subjektivität gilt als Ressource @braun2019reflecting.]),
  ([Rektifikator], "rectifier", "6", [Mittlerer Fehler der Modellvorhersagen auf der Goldstichprobe, mit dem PPI die Schätzung auf den ungelabelten Daten korrigiert @angelopoulos2023prediction.]),
  ([Reliabilität], "reliability", "1, 5", [Konsistenz einer Messung über Wiederholungen, Codierende oder Formulierungen. Notwendige, aber nicht hinreichende Bedingung für Validität.]),
  ([Replikationskrise], "replication crisis", "1", [Befund, dass viele publizierte Ergebnisse sich nicht replizieren lassen; im Reproducibility Project war nur etwa ein Drittel der Replikationen signifikant @collaboration2015estimating.]),
  ([Reporting-Checkliste], "reporting checklist", "10", [Strukturierte Liste der Angaben, die eine Publikation enthalten soll, etwa REFORMS für ML-basierte Wissenschaft @kapoor2024reforms oder Leitlinien für LLM-Studien im Software Engineering @baltes2025guidelines.]),
  ([Repräsentativität], "representativeness", "4", [Übereinstimmung der Antwortverteilungen eines Modells mit denen einer menschlichen Gruppe @santurkar2023whose.]),
  ([Reproduzierbarkeit], "reproducibility", "10", [Möglichkeit, ein Ergebnis mit denselben Daten und Methoden erneut zu erhalten; abzugrenzen von Wiederholbarkeit (gleicher Aufbau, gleiche Ausgaben) und Determinismus (bitgleiche Ausgaben).]),
  ([Reward Model], "reward model", "7", [Modell, das Antworten einen skalaren Präferenzwert zuweist; RewardBench prüft, ob es die bevorzugte Antwort höher bewertet @lambert2025rewardbench.]),
  ([Robustheitsrate], "robustness rate", "7, 8", [Anteil der Urteile, die nach einer biasspezifischen Störung gleich bleiben; nur relativ zur Konsistenzrate ungestörter Wiederholungen interpretierbar @ye2025justice.]),
  ([Rubrik], "rubric", "7", [Bewertungsschema mit Kriterien und Beschreibung jeder Scorestufe, das einem Richter vorgegeben wird @kim2024prometheus2.]),
  ([Sandwich-Varianz], "sandwich variance", "6, 7", [Robuste Varianzschätzung der Form $A^(-1) B A^(-1)$ für M-Schätzer; Grundlage der PPI-Intervalle für Regressionen und der Bradley-Terry-Intervalle.]),
  ([Sättigung], "saturation", "1", [Punkt, ab dem weitere Interviews kaum neue Codes oder Themen liefern; empirisch oft zwischen 9 und 17 Interviews @hennink2022sample, für reflexive thematische Analyse als Stoppregel abgelehnt @braun2021saturate.]),
  ([Scotts Pi], "Scott's pi", "5", [Zufallskorrigierte Übereinstimmung zweier Codierender mit gepoolten Randverteilungen @scott1955reliability.]),
  ([SEAT], "Sentence Encoder Association Test", "8", [Übertragung des WEAT auf Satzeinbettungen mit semantisch neutralen Satzvorlagen @may2019measuring.]),
  ([Selbstpräferenz], "self-preference bias", "7", [Neigung eines Richtermodells, eigene Ausgaben besser zu bewerten @panickssery2024llm.]),
  ([Self-Consistency], none, "3", [Mehrfaches Sampeln von Reasoning-Pfaden und Mehrheitsentscheid über die Endantworten @wang2023selfconsistency.]),
  ([Separierbarkeit], "separability", "7", [Anteil der Modellpaare, deren Bootstrap-Konfidenzintervalle sich nicht überlappen; misst, wie gut ein Benchmark Modelle trennt @li2025crowdsourced.]),
  ([Silicon Sampling], "silicon sampling", "4", [Erzeugung synthetischer Umfrageantworten durch ein LLM, das auf soziodemografische Profile konditioniert wird @argyle2023out; ob es menschliche Stichproben ersetzen kann, ist umstritten @bisbee2024synthetic.]),
  ([Spielraum (Alt-Test)], "cost-benefit margin", "5", [Parameter $epsilon$ des Alternative Annotator Tests, der festlegt, wie viel Qualitätsverlust für die Kostenersparnis akzeptiert wird; als Faustregel 0.2 für Fachleute, 0.15 für geschulte Annotatoren, 0.1 für Crowdworker. Muss vor dem Test begründet und fixiert werden @calderon2025alternative.]),
  ([Statistischer Realismus], "statistical realism", "4", [Ähnlichkeit simulierter Einzelantworten mit echten Antworten; nicht dasselbe wie Effektvalidität @li2026statistical.]),
  ([Statistische Schlussvalidität], "statistical conclusion validity", "1", [Frage, ob eine Kovariation zwischen Treatment und Outcome real ist und korrekt geschätzt wurde; bedroht durch geringe Power, multiples Testen und unreliable Messungen @shadish2002experimental.]),
  ([StereoSet], none, "8", [Benchmark mit stereotypen, anti-stereotypen und sinnlosen Optionen; kombiniert Sprachmodellierungsqualität und Stereotypenpräferenz im ICAT-Score @nadeem2021stereoset.]),
  ([Steuerbarkeit], "steerability", "4", [Ausmaß, in dem sich ein Modell per Prompt auf die Meinungsverteilung einer bestimmten Gruppe lenken lässt @santurkar2023whose.]),
  ([Surrogat], "surrogate label", "6", [Günstiges, fehlerbehaftetes Ersatzlabel wie ein LLM-Label, das die teure Zielvariable vertreten soll @egami2023using.]),
  ([TAR\@N], "total agreement rate", "10", [Anteil der Items, bei denen alle $N$ wiederholten Läufe dieselbe Ausgabe liefern; TARr vergleicht Rohtext, TARa geparste Antworten @atil2025nondeterminism.]),
  ([Temperatur], "temperature", "3, 10", [Decodierparameter, der die Wahrscheinlichkeitsverteilung über Tokens schärft oder abflacht. Temperatur 0 garantiert bei gehosteten Modellen keine identischen Ausgaben @atil2025nondeterminism.]),
  ([Test-Retest-Reliabilität], "test-retest reliability", "4, 5", [Übereinstimmung wiederholter Messungen desselben Objekts. Bei Personen bildet sie die Obergrenze dafür, wie gut ein Agent sie vorhersagen kann @park2024llm.]),
  ([Thematische Analyse], "thematic analysis", "1, 5", [Verfahren zur Identifikation, Analyse und Darstellung von Mustern in qualitativen Daten in sechs Phasen @braun2006using.]),
  ([TICK], none, "7", [Bewertungsansatz, bei dem ein LLM aus der Instruktion eine Checkliste von Ja/Nein-Fragen erzeugt, die ein Richter je Antwort beantwortet @cook2024ticking.]),
  ([Token], none, "3, 10", [Kleinste Verarbeitungseinheit eines Sprachmodells; Ein- und Ausgabetokens sind die Abrechnungsgrundlage aller Kostenmodelle @anthropic2026pricing.]),
  ([Turing-Experiment], "Turing experiment", "4", [Simulation eines klassischen Experiments mit vielen vom LLM gespielten Teilnehmenden, um zu prüfen, ob bekannte Befunde reproduziert werden @aher2023using.]),
  ([Validierungsstichprobe], "validation sample", "5", [Zufällig aus dem Zielkorpus gezogene, von Menschen gelabelte Teilmenge zur Prüfung eines LLM-Annotators; Entwicklungs- und gesperrter Testteil sind zu trennen @pangakis2023automated.]),
  ([Validität], "validity", "1", [Angemessenheit der Schlüsse aus einer Studie; nach Shadish, Cook und Campbell gegliedert in statistische Schlussvalidität, interne, Konstrukt- und externe Validität @shadish2002experimental.]),
  ([Wasserstein-Distanz], "Wasserstein distance", "4, 8", [Abstandsmaß zwischen Verteilungen, für ordinale Antworten die Summe der Beträge der Differenzen der Verteilungsfunktionen @santurkar2023whose.]),
  ([WEAT], "Word Embedding Association Test", "8", [Test auf Assoziationen zwischen Zielwort- und Attributmengen in Worteinbettungen, analog zum Impliziten Assoziationstest, mit Effektstärke und Permutationstest @caliskan2017semantics.]),
  ([Wissensbeitrag], "knowledge contribution", "2", [Einordnung eines DSR-Ergebnisses nach Reife von Problem- und Lösungsdomäne als Verbesserung, Erfindung, Exaptation oder Routinedesign @gregor2013positioning.]),
  ([Zero-Shot-Prompting], "zero-shot prompting", "3", [Prompting ohne Beispiele, nur mit Instruktion und Eingabe @schulhoff2024prompt.]),
  ([Zufallskorrigierte Übereinstimmung], "chance-corrected agreement", "5", [Familie von Koeffizienten der Form $(p_o - p_e) \/ (1 - p_e)$, die sich nur in der Definition der Zufallsübereinstimmung unterscheiden @artstein2008inter.]),
)

