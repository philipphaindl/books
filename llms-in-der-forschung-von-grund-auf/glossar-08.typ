#let begriffe = (
  ("Sozialer Bias (social bias)", [Eine ungleiche Behandlung oder ein ungleiches Ergebnis zwischen sozialen Gruppen, das aus historischen und strukturellen Machtunterschieden stammt.], 8),
  ("Repräsentationaler Schaden (representational harm)", [Ein Schaden durch das, was ein Modell über Gruppen sagt, etwa Stereotype, abwertende Sprache oder das Unsichtbarmachen einer Gruppe.], 8),
  ("Allokativer Schaden (allocational harm)", [Ein Schaden durch die Verteilung von Chancen und Ressourcen, etwa wenn eine Gruppe seltener zum Gespräch eingeladen oder bei Krediten schlechter gestellt wird.], 8),
  ("Intrinsische und extrinsische Metrik", [Eine intrinsische Metrik misst im Inneren des Modells (Wortkarte, Satzwahrscheinlichkeiten), eine extrinsische an dem, was bei einer Aufgabe herauskommt (Antworten, Texte, Entscheidungen).], 8),
  ("Invarianz (invariance)", [Die Forderung, dass sich die Ausgabe eines Modells nicht ändert, wenn sich in der Eingabe nur die genannte Gruppe ändert; die Grundlage aller Tauschtests.], 8),
  ("Einbettung (embedding)", [Die Darstellung eines Wortes als Punkt auf einer Art Landkarte, auf der ähnlich gebrauchte Wörter nahe beieinanderliegen.], 8),
  ("WEAT", [Der Word Embedding Association Test misst, ob zwei Gruppen von Wörtern, etwa männliche und weibliche Namen, auf der Wortkarte unterschiedlich nah an zwei Gruppen von Attributwörtern liegen.], 8),
  ("CrowS-Pairs", [Ein Benchmark aus Satzpaaren, die sich nur in der genannten Gruppe unterscheiden; der Wert ist der Anteil der Paare, bei denen das Modell den stereotypen Satz bevorzugt, ideal ist 50.], 8),
  ("StereoSet (lms, ss, icat)", [Ein Benchmark mit drei Endungen je Satzanfang; `lms` misst die Sprachqualität, `ss` die Vorliebe für das Stereotyp (ideal 50) und `icat` beides in einer Zahl.], 8),
  ("BBQ", [Der Bias Benchmark for QA stellt Rätsel mit zwei Personen, bei denen im mehrdeutigen Fall "unbekannt" richtig ist, und misst, ob das Modell stattdessen dem Stereotyp folgt.], 8),
  ("Selektionsrate (selection rate)", [Der Anteil einer Gruppe, der von einem Modell ein Ja bekommt, zum Beispiel 60 Einladungen auf 100 Bewerbungen.], 8),
  ("Demographic parity", [Das Fairness-Kriterium, dass jede Gruppe gleich oft ein Ja bekommt; gemessen als Abstand oder Verhältnis der Selektionsraten.], 8),
  ("Vier-Fünftel-Regel (four-fifths rule)", [Die aus dem US-Arbeitsrecht bekannte Faustregel, dass die niedrigere Selektionsrate mindestens vier Fünftel (0,8) der höheren betragen soll.], 8),
  ("Equalized odds und equal opportunity", [Kriterien, die gleiche Trefferquote (TPR) und gleiche Quote irrtümlicher Ja (FPR) in allen Gruppen verlangen, beziehungsweise nur gleiche Trefferquote unter den Qualifizierten.], 8),
  ("Kontrafaktisches Audit (counterfactual audit)", [Ein Experiment, das dem Modell dieselbe Eingabe zweimal vorlegt und nur ein Merkmal ändert, das die Gruppe verrät, etwa den Namen, und die Ausgaben vergleicht.], 8),
  ("McNemar-Test", [Ein Test für gepaarte Ja-Nein-Entscheidungen, der nur die Paare zählt, in denen sich die Entscheidungen unterscheiden, und prüft, ob eine Richtung deutlich häufiger ist als die andere.], 8),
  ("Robustness Rate und Consistency Rate", [Die Robustness Rate sagt, wie oft ein Urteil nach einem eingefügten Hinweis gleich bleibt, die Consistency Rate, wie oft es bei einer bloßen Wiederholung gleich bleibt; erst der Vergleich beider zeigt den Einfluss des Hinweises.], 8),
)
