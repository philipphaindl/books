#let begriffe = (
  ("Messgerät (Instrument)", [Bei einem LLM-Simulator die Kombination aus Modellversion, Prompt-Vorlage, Einstellungen wie der Temperatur und dem Parser, der aus dem Antworttext eine Zahl macht; ändert sich ein Teil, ist es ein anderes Messgerät.], 4),
  ("Reliabilität (reliability)", [Wie gut eine Messung bei Wiederholung dasselbe Ergebnis liefert, wie eine Waage, die dreimal hintereinander fast dasselbe Gewicht zeigt.], 4),
  ("Validität (validity)", [Wie gut eine Zahl tatsächlich bedeutet, was man mit ihr behauptet; ein Gerät kann zuverlässig sein und trotzdem das Falsche messen.], 4),
  ("Test-Retest", [Zuverlässigkeitsprüfung, bei der dasselbe zweimal gemessen und verglichen wird; bei LLMs mit neuer Sitzung, anderer Modellversion oder anderer Formulierung.], 4),
  ("Silicon Sample", [Eine Gruppe künstlicher Befragter, die ein Sprachmodell aus den Profilen echter Personen erzeugt, ein Zwilling pro Person.], 4),
  ("Algorithmic Fidelity (algorithmische Treue)", [Wie getreu ein Modell die Antwortmuster verschiedener Gruppen abbildet; entscheidend ist, ob auch die Zusammenhänge zwischen Antworten stimmen.], 4),
  ("Turing Experiment", [Eine repräsentative künstliche Stichprobe spielt eine klassische Studie mit Menschen nach, im Unterschied zum Turing-Test, der ein einzelnes Individuum betrifft.], 4),
  ("Generative Agent", [Ein Sprachmodell mit Gedächtnis, Reflexion und Planung, das in einer simulierten Welt handelt; seine Glaubwürdigkeit ist noch kein Beleg für realistisches Verhalten.], 4),
  ("Alignment-Score (OpinionQA)", [Eine Zahl zwischen 0 und 1, wie ähnlich das Antwortmuster eines Modells dem von Menschen ist (1 = gleich); er übersieht, wenn dem Modell die Streuung fehlt.], 4),
  ("Wasserstein-Distanz", [Der Aufwand, einen Haufen Antworten in einen anderen zu verwandeln, wie Sand von einem Haufen zum anderen tragen; Grundlage des Alignment-Scores.], 4),
  ("Entropie", [Ein Maß dafür, wie breit sich Antworten auf die Optionen verteilen; 0 heißt, alle wählen dieselbe Option.], 4),
  ("Abflachung (flattening)", [Die Antworten eines Modells für eine Gruppe sind weniger vielfältig als die der echten Gruppenmitglieder.], 4),
  ("Hyper-Genauigkeit", [Ausgerichtete Modelle kennen die richtige Antwort zu gut und können deshalb die Fehler und die Streuung einer echten Menschenmenge nicht nachahmen.], 4),
  ("Kontamination (contamination)", [Die Testaufgabe oder ihre Lösung stand schon in den Trainingsdaten des Modells, sodass gute Ergebnisse auf Auswendiglernen beruhen können.], 4),
  ("Drift", [Stille Änderungen an einem gehosteten Modell, durch die derselbe Prompt zu anderer Zeit andere Antworten liefert; Gegenmittel sind festgehaltene Version und protokolliertes Datum.], 4),
  ("GUIDE-LLM", [Eine Konsens-Checkliste mit 14 Kernpunkten und 8 optionalen Punkten dafür, was eine Studie mit Sprachmodellen berichten sollte.], 4),
  ("Instrumentenkarte", [Eine kurze Dokumentation des Messgeräts mit Modellversion, Zugriffsdatum, Einstellungen, Prompts, Wiederholungen, Parser und Zuverlässigkeitsmaßen.], 4),
)
