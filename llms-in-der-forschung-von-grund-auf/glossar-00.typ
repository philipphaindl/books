#let begriffe = (
  ("Prompt", [Der Text, den man einem Sprachmodell als Eingabe gibt: Anweisung, eventuell Beispiele und die Daten, um die es geht.], 0),
  ("Token", [Das Stück Text, mit dem ein Sprachmodell rechnet, also ein kurzes Wort, ein Wortteil oder ein Satzzeichen; nach Token wird auch abgerechnet.], 0),
  ("Kontextfenster (context window)", [Die Obergrenze für die Menge an Text, die ein Sprachmodell in einem Aufruf auf einmal sehen kann, Eingabe und Antwort zusammen.], 0),
  ("Temperatur (temperature)", [Eine Einstellung, die bestimmt, wie stark ein Sprachmodell beim Auswählen des nächsten Textstücks vom Wahrscheinlichsten abweicht und damit, wie stark die Antworten streuen.], 0),
  ("Halluzination (hallucination)", [Ein flüssiger, plausibel klingender Text eines Sprachmodells, der falsch oder erfunden ist, zum Beispiel eine nicht existierende Quelle.], 0),
  ("Stichprobe (sample)", [Der Teil einer größeren Menge, den man tatsächlich untersucht, um auf die ganze Menge zu schließen; sie sollte zufällig gezogen sein.], 0),
  ("Noise (Zufallsschwankung)", [Der Anteil eines Fehlers, der von Mal zu Mal zufällig mal nach oben, mal nach unten abweicht und sich mit mehr Daten verkleinert.], 0),
  ("Bias (Verzerrung)", [Ein systematischer Fehler, der Ergebnisse immer in dieselbe Richtung verschiebt und durch mehr Daten nicht verschwindet.], 0),
  ("Konfidenzintervall (confidence interval)", [Eine Spanne plausibler Werte für eine Größe, die aus einer Stichprobe geschätzt wurde; sie wird mit mehr Daten enger.], 0),
  ("p-Wert (p-value)", [Die Antwort auf die Frage, wie oft ein mindestens so auffälliges Ergebnis vorkäme, wenn nur der Zufall im Spiel wäre; unter 5 % heißt es üblicherweise signifikant, eine Wahrscheinlichkeit für die Hypothese ist er nicht.], 0),
  ("Effektstärke (effect size)", [Ein Maß dafür, wie groß ein Unterschied oder Zusammenhang tatsächlich ist, unabhängig davon, ob er signifikant ist.], 0),
  ("Korrelation (correlation)", [Ein Maß zwischen -1 und +1 dafür, wie gleichläufig sich zwei Zahlenreihen bewegen; sie sagt nichts über Ursache oder Gleichheit.], 0),
  ("Gold-Labels (ground truth)", [Einordnungen, die als richtig gelten, weil sorgfältige Menschen sie vergeben haben; sie dienen als Maßstab für ein Modell.], 0),
  ("Vierfeldertafel (confusion matrix)", [Eine Zähltabelle, die für zwei Klassen zeigt, wie oft ein Modell richtig positiv, richtig negativ, falsch positiv und falsch negativ lag.], 0),
  ("Accuracy", [Der Anteil aller Fälle, in denen das Modell richtig lag; täuscht, wenn eine Klasse sehr selten ist.], 0),
  ("Precision und Recall", [Precision ist der Anteil echter Treffer unter allen Fällen, die das Modell als positiv meldet; Recall ist der Anteil der wirklich positiven Fälle, die das Modell findet.], 0),
  ("Cohen's kappa", [Ein Maß für die Übereinstimmung zweier Beurteiler, bei dem die Treffer herausgerechnet sind, die schon durch Zufall zu erwarten wären.], 0),
  ("Reliabilität (reliability)", [Die Eigenschaft einer Messung, bei Wiederholung dasselbe Ergebnis zu liefern.], 0),
  ("Validität (validity)", [Die Eigenschaft einer Messung, tatsächlich das zu messen, was sie messen soll.], 0),
  ("Reproduzierbarkeit (reproducibility)", [Andere kommen mit denselben Daten und demselben Vorgehen zum selben Ergebnis.], 0),
)
