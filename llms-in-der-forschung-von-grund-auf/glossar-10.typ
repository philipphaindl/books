#let begriffe = (
  ("Snapshot", [Eine Modellversion mit festem Datum im Namen, zum Beispiel `claude-sonnet-4-5-20250929`, die sich nicht mehr ändern soll und irgendwann abgeschaltet wird.], 10),
  ("Alias", [Ein Modellname wie `latest`, hinter dem der Anbieter jederzeit eine neuere Version einsetzen kann; in Studien sollte man ihn nie verwenden.], 10),
  ("Drift (model drift)", [Die stille Veränderung des Verhaltens eines gehosteten Modells über die Zeit, obwohl der Modellname gleich bleibt.], 10),
  ("Batch-Invarianz (batch invariance)", [Eigenschaft einer Rechenroutine, bei der das Ergebnis für eine Anfrage nicht davon abhängt, wie viele andere Anfragen gerade im selben Paket mitlaufen.], 10),
  ("Numerisches Rauschen (numerical nondeterminism)", [Kleine Abweichungen durch Rundung, wenn der Server dieselben Zahlen je nach Auslastung in anderer Reihenfolge addiert, sodass auch bei Temperatur 0 ein anderes Wort gewinnen kann.], 10),
  ("TAR@N (Total Agreement Rate)", [Der Anteil der Items in Prozent, bei denen alle N Läufe mit gleichen Einstellungen dieselbe Ausgabe liefern; 100 heißt perfekt stabil, TARr vergleicht den rohen Text, TARa die geparste Antwort.], 10),
  ("Unique-Output-Anteil", [Die Zahl verschiedener Texte unter den Wiederholungen einer Anfrage geteilt durch die Zahl der Läufe; je niedriger, desto wiederholbarer.], 10),
  ("Parser", [Der Code, der aus der Textantwort eines Modells das Label oder den Wert herausliest; er legt fest, was als gleiche Antwort zählt.], 10),
  ("Hash (SHA-256)", [Ein Fingerabdruck eines Textes oder einer Datei, der sich schon bei einem geänderten Zeichen völlig verändert und so Änderungen beweisbar macht.], 10),
  ("Manifest", [Eine Datei pro Lauf, die Modell, Version, Einstellungen, Hashes, Zeitpunkt und Kosten festhält und so jede Zahl im Bericht auf ihre Herkunft zurückführbar macht.], 10),
  ("Preregistration", [Das Festschreiben von Fragen, Hypothesen und Analyseplan mit Zeitstempel, bevor man die Ergebnisse sieht.], 10),
  ("Power-Analyse (power analysis)", [Die Planung, wie viele Testitems nötig sind, damit ein echter Unterschied eine faire Chance hat, in den Daten aufzufallen.], 10),
  ("Open weights", [Ein Modell, dessen Gewichte man herunterladen, selbst betreiben und archivieren kann, anders als ein gehostetes Modell.], 10),
  ("Prompt Caching", [Der Anbieter merkt sich den unveränderten Anfang eines Prompts, etwa das Codebuch, und berechnet das erneute Lesen deutlich billiger als normale Eingabe.], 10),
  ("Batch-API", [Eine Schnittstelle, bei der man viele Anfragen auf einmal einreicht und die Ergebnisse später zum halben Preis abholt.], 10),
  ("Sensitivität (sensitivity)", [Von allen wirklich relevanten Arbeiten der Anteil, den der Screener findet; 97 von 100 heißt, dass drei übersehen werden.], 10),
  ("Zero Data Retention (ZDR)", [Die Zusage eines Anbieters, Inhalte nicht in Protokollen zur Missbrauchsüberwachung aufzubewahren; sie muss meist vorab genehmigt werden und gilt für Batch-Verarbeitung nicht.], 10),
  ("Deployer (Betreiber)", [Wer ein KI-System einsetzt, ohne es selbst zu bauen; nach dem EU AI Act muss er die KI-Kompetenz seines Personals unterstützen.], 10),
)
