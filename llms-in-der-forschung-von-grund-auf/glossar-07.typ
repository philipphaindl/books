#let begriffe = (
  ("LLM-as-a-Judge", [Ein Sprachmodell, das Antworten anderer Modelle bewertet, statt dass Menschen sie lesen und benoten.], 7),
  ("Meta-Evaluation", [Die Bewertung des Bewerters selbst, zum Beispiel indem man prüft, wie gut ein Richter-Modell mit Menschen übereinstimmt.], 7),
  ("Pointwise, Pairwise, Listwise", [Die drei Eingabeformate eines Richters: eine Antwort mit Punktzahl, zwei Antworten im Vergleich oder eine ganze Liste mit Rangfolge.], 7),
  ("Rubrik (rubric)", [Eine Beschreibung des Kriteriums mit einem Satz für jede Punktestufe, damit der Richter dieselbe Skala anlegt wie du.], 7),
  ("Reference-guided", [Der Richter bekommt zusätzlich eine Musterlösung; sie hilft nur, wenn sie wirklich stimmt.], 7),
  ("Nachsicht (leniency)", [Der Anteil der Fehler eines Richters, in denen er "richtig" sagt, obwohl der Mensch "falsch" sagt; nahe 1 heißt zu großzügig.], 7),
  ("Scotts pi", [Ein Maß für Übereinstimmung jenseits des Zufalls wie Cohens kappa, das die Gewohnheiten beider Beurteiler zusammenwirft und dadurch etwas strenger ist.], 7),
  ("Rangkorrelation (Spearman)", [Prüft, ob zwei Listen dieselbe Reihenfolge haben: 1 heißt gleiche Reihenfolge, 0 kein Zusammenhang, -1 umgekehrte Reihenfolge.], 7),
  ("Position bias", [Der Richter bevorzugt eine Antwort, weil sie an einer bestimmten Stelle im Prompt steht, zum Beispiel vorn.], 7),
  ("Verbosity bias", [Der Richter belohnt längere Antworten unabhängig vom Inhalt.], 7),
  ("Self-preference", [Der Richter bevorzugt Texte, die denen seiner eigenen Modellfamilie ähneln.], 7),
  ("Konfliktrate (conflict rate)", [Der Anteil der Paare, deren Urteil sich ändert, wenn man die Reihenfolge der beiden Antworten vertauscht.], 7),
  ("Panel of judges (PoLL)", [Mehrere kleinere Richter aus verschiedenen Modellfamilien, deren Urteile per Abstimmung zusammengefasst werden.], 7),
  ("Faktor-zwei-Grenze", [Ein Richter, der nicht besser ist als das bewertete Modell, spart höchstens etwa die Hälfte der menschlichen Labels.], 7),
  ("Alternative Annotator Test", [Ein Ablauf, der prüft, ob ein LLM einen menschlichen Annotator ersetzen kann, ohne dass es auffiele.], 7),
  ("Bradley-Terry-Modell", [Ein Verfahren, das aus vielen Zweikämpfen eine Stärke je Modell schätzt, ähnlich einer Schach-Rangliste.], 7),
  ("Separability", [Der Anteil der Modellpaare eines Benchmarks, deren Fehlerspannen sich nicht überlappen und deren Reihenfolge deshalb klar ist.], 7),
  ("Bootstrap", [Ein Verfahren, bei dem man aus den vorhandenen Daten immer wieder zufällig neu zieht, um zu sehen, wie stark ein Ergebnis schwankt.], 7),
)
