#let begriffe = (
  ("Design Science Research (DSR)", [Ein Forschungsansatz, bei dem man ein Artefakt für ein erkanntes Problem baut und streng bewertet, um daraus übertragbares Wissen zu gewinnen.], 2),
  ("Artefakt (artefact)", [Etwas von Menschen Gebautes, das ein Problem lösen soll, etwa ein Begriffssystem, ein Modell, ein Verfahren oder ein lauffähiges System.], 2),
  ("Relevance, rigour und design cycle", [Die drei Zyklen der DSR: Der Relevanz-Zyklus verbindet das Projekt mit der Umwelt, der Rigour-Zyklus mit dem Wissensstand, der Design-Zyklus ist die Schleife aus Bauen und Bewerten.], 2),
  ("DSRM (Design Science Research Methodology)", [Ein Ablauf mit sechs Aktivitäten: Problem erkennen, Ziele festlegen, entwerfen und bauen, vorführen, evaluieren, berichten, mit Rückschleife von der Evaluation zum Entwurf.], 2),
  ("Action Design Research (ADR)", [Eine DSR-Variante, bei der Bauen, Eingreifen in die Organisation und Bewerten gleichzeitig laufen, geeignet für Arbeiten mit einem Industriepartner.], 2),
  ("Validation und Evaluation", [Validation sagt vor dem Einsatz voraus, ob ein Artefakt die Anforderungen erfüllt; Evaluation misst nach dem realen Einsatz die tatsächlichen Wirkungen.], 2),
  ("FEDS", [Ein Rahmen zur Planung von Evaluationen in der DSR, der jede Bewertung nach Zweck (verbessern oder beurteilen) und Ort (kontrolliert oder real) einordnet.], 2),
  ("Formative und summative Evaluation", [Formativ heißt, das Artefakt zu verbessern; summativ heißt, zu beurteilen, wie gut das Ergebnis zu den Erwartungen passt.], 2),
  ("Artificial und naturalistic", [Artificial meint eine Bewertung unter kontrollierten Bedingungen wie Labor oder Simulation, naturalistic eine mit echten Nutzern, echten Aufgaben und echter Umgebung.], 2),
  ("Exaptation", [Eine Beitragsart, bei der eine bekannte Lösung auf ein neues Problem übertragen wird; daneben gibt es Invention, Improvement und Routine design.], 2),
  ("Designprinzip", [Ein Lückensatz, der festhält, welche Mechanismen für wen in welchem Kontext welches Ziel erreichen und aus welchem Grund.], 2),
  ("Technologische Regel", [Eine Aussage der Form "Um einen Effekt in einer Situation zu erreichen, wende eine Maßnahme an".], 2),
  ("Artefact mutability", [Der Teil einer Designtheorie, der festlegt, welche Veränderungen am Artefakt (anderes Modell, anderer Prompt, anderes Textkorpus) die Theorie noch abdeckt.], 2),
  ("Jaccard-Index", [Das Maß für die Überlappung zweier Listen: Wie viele Elemente stehen in beiden, gemessen an allen, die in mindestens einer vorkommen.], 2),
  ("F1-Score", [Eine einzige Zahl, die Precision und Recall zusammenfasst und sinkt, sobald eine von beiden niedrig ist.], 2),
  ("Stability Index (SI)", [Eine Zahl zwischen 0 und 1, die angibt, wie wenig die Qualität eines Ergebnisses durch Umformulieren der Aufgabe und durch Wiederholen schwankt; sie sollte nie allein berichtet werden.], 2),
  ("Data contamination", [Der Fall, dass die Daten eines Tests schon im Training des Modells enthalten waren und die Ergebnisse deshalb zu gut ausfallen.], 2),
  ("DSR Grid", [Eine Seite mit sechs Feldern (Problem, vorhandenes Wissen, Forschungsprozess, Schlüsselbegriffe, Lösung, neues Wissen), mit der man eine DSR-Arbeit plant.], 2),
)
